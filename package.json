{
  "name": "adp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace apps/server",
    "test:parser": "cd apps/parser && .venv/bin/python -m pytest tests -q",
    "test:e2e": "node --test tests/e2e.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs",
    "start": "node --env-file-if-exists=.env apps/server/dist/index.js"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
