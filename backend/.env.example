# 本地开发配置。复制成 backend/.env 使用；.env 不提交。
# 下面的密码只用于本地开发容器，不要当成生产默认值。
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://adp_app:adp_app_pw@localhost:55432/adp
MIGRATION_DATABASE_URL=postgresql+asyncpg://adp_migrator:adp_migrator_pw@localhost:55432/adp
REDIS_URL=redis://localhost:56379/0
JWT_SECRET=dev-only-secret-change-me-0123456789
# 模型密钥的加密主密钥，Base64 编码的 32 字节。本地开发固定值，不要用于生产。
MASTER_KEY=ZGV2LW1hc3Rlci1rZXktLTAxMjM0NTY3ODlhYmNkZWY=
# 本地开发走 http，置 false；生产必须 true
COOKIE_SECURE=false
LOG_LEVEL=INFO
