# 生产部署配置示例。执行 deploy/gen-secrets.sh 生成一份 deploy/.env（密码和密钥随机），
# 再按需要修改。deploy/.env 不提交。
#
# 主机名用 compose 的服务名（postgres、redis），api 和 migrate 在容器网络内访问。

# ---- 数据库密码 ----
# PostgreSQL 超级用户密码，只在 postgres 容器内部使用。
POSTGRES_PASSWORD=change-me-postgres-superuser
# 迁移账号（表的所有者），只给 migrate 容器。
ADP_MIGRATOR_PASSWORD=change-me-migrator
# 应用账号（业务表读写，审计表只能 INSERT / SELECT），api 使用。
ADP_APP_PASSWORD=change-me-app

# ---- 连接串 ----
# 应用账号连接串，给 api；密码要和 ADP_APP_PASSWORD 一致。
DATABASE_URL=postgresql+asyncpg://adp_app:change-me-app@postgres:5432/adp
# 迁移账号连接串，只给 migrate；密码要和 ADP_MIGRATOR_PASSWORD 一致。
MIGRATION_DATABASE_URL=postgresql+asyncpg://adp_migrator:change-me-migrator@postgres:5432/adp
# Redis 连接串。
REDIS_URL=redis://redis:6379/0

# ---- 密钥 ----
# JWT 签名密钥，必须随机生成并备份（丢失后所有人需要重新登录）。
JWT_SECRET=change-me-at-least-32-bytes-random
# 模型密钥的加密主密钥，Base64 编码的 32 字节，必须随机生成并备份。
# 丢失后所有已保存的模型密钥都无法解密，只能重新录入。
MASTER_KEY=change-me-base64-32-bytes

# ---- 模型调用（第二期）----
# LiteLLM 不在启动时联网拉取模型价格表（代码里已默认设置，这里显式写出便于核对）。
LITELLM_LOCAL_MODEL_COST_MAP=True

# ---- 对象存储（第三期）----
# RustFS 容器的访问凭据，必须随机生成并备份（api / worker / parser 都用它）。
S3_ACCESS_KEY=change-me-rustfs-access-key
S3_SECRET_KEY=change-me-rustfs-secret-key
# api / worker 访问对象存储的地址、桶名和区域（容器内用服务名 rustfs）。
S3_ENDPOINT=http://rustfs:9000
S3_BUCKET=adp
S3_REGION=us-east-1

# ---- 解析服务（第三期）----
# api / worker 访问解析服务用；PARSER_TOKEN 必须随机生成，解析服务用它做 Bearer 认证。
PARSER_URL=http://parser:59001
PARSER_TOKEN=change-me-parser-token
# 解析服务的常驻进程数（知识库技术方案 6.3）
PARSER_WORKERS=2

# ---- Celery（第三期）----
# 消息队列用 Redis 的另一个库号；批量入库 worker 的并发数。
CELERY_BROKER_URL=redis://redis:6379/1
WORKER_CONCURRENCY=2

# ---- 应用 ----
APP_ENV=prod
# 生产走 HTTPS，必须为 true。
COOKIE_SECURE=true

# ---- 可选 ----
# 客户网络需要代理才能访问云模型供应商时填写，例如 http://proxy.example.com:8080。
# 只对 api 容器生效；migrate 不需要出网。
# HTTPS_PROXY=http://proxy.example.com:8080

# ---- 宿主机端口（补充）----
# nginx 对外的 HTTP / HTTPS 端口。前面没有别的反向代理时用 80 / 443。
HTTP_PORT=80
HTTPS_PORT=443
